# Supported providers: opencode-go or claude-ai.
# claude-code and codex are placeholders and will return an unsupported-provider error.
AI_USAGE_WATCH_PROVIDER=opencode-go

# Required for opencode-go.
OPENCODE_WORKSPACE_ID=wrk_your_workspace_id

# Optional: set only if auto-detection does not find a Chromium-compatible browser.
CHROMIUM_PATH=/usr/bin/chromium

# Optional overrides.
# AI_USAGE_WATCH_CONFIG=/path/to/config.json
# AI_USAGE_WATCH_ENV=/path/to/.env
