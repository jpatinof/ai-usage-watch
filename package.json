{
  "name": "ai-usage-watch",
  "version": "1.0.0",
  "description": "Monitor AI subscription usage from the terminal",
  "type": "module",
  "bin": {
    "ai-usage-watch": "./dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "npm run build && node dist/index.js",
    "help": "npm run build && node dist/index.js --help",
    "test": "npm run build && node --test tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "usage",
    "subscription",
    "opencode",
    "monitor"
  ],
  "license": "MIT"
}
